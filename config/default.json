{
  "$comment": "Claude Enterprise Audit Dashboard configuration. Every field is optional; see docs/SETUP.md. Secrets never go here (environment variables only).",
  "dashboard": {
    "title": "Claude Enterprise Audit Dashboard",
    "maskPii": true
  },
  "sources": {
    "disabled": [],
    "members": { "provider": "admin" },
    "memberActivity": { "lookbackDays": 90 },
    "groups": { "maxMemberRequests": 200 },
    "activities": {
      "initialLookbackHours": 168,
      "overlapMinutes": 10,
      "lagMinutes": 2,
      "pageSize": 5000,
      "includeTypes": [],
      "excludeTypes": [
        "claude_artifact_comments_viewed",
        "claude_artifact_viewed",
        "claude_chat_snapshot_viewed",
        "claude_chat_viewed",
        "claude_file_viewed",
        "claude_project_document_viewed",
        "claude_project_viewed",
        "design_project_viewed"
      ]
    }
  },
  "compliance": {
    "disabledRules": [],
    "params": {
      "UA-002": { "monthlyBudget": 10000, "currency": "USD" }
    }
  },
  "notifications": {
    "statuses": ["fail", "warning"],
    "minSeverity": "high",
    "cooldownMinutes": 360
  },
  "retention": {
    "snapshotDays": 365
  },
  "capacity": {
    "maxTotalMiB": 1024,
    "maxMonthlyGrowthMiB": 50,
    "warnRatio": 0.8,
    "windowDays": 30
  }
}
