# ==================================
# Claude Enterprise Audit Dashboard
# Environment Configuration
# ==================================

# --- Required: Anthropic API Keys ---

# Admin API Key (sk-ant-admin...)
# Create at: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=

# Compliance Access Key
# Create at: Organization Settings > Data and Privacy > Compliance Access Keys
# Note: Requires Primary Owner role
ANTHROPIC_COMPLIANCE_API_KEY=

# --- Optional: Notification Channels ---

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Email (SMTP) Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# --- Optional: Collection Settings ---

# Organization ID (auto-detected if not set)
ORGANIZATION_ID=

# Data directory path (default: ./data)
DATA_DIR=./data

# Full sync on first run (default: true)
FULL_SYNC=true
