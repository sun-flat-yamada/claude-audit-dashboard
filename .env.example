# ==================================
# Claude Enterprise Audit Dashboard
# Local environment (copy to .env; never commit .env)
# GitHub Actions reads the same names from repository secrets.
# ==================================

# --- Anthropic: one Enterprise key (required for live collection) ---
# Created by the primary owner in claude.ai: Organization settings > API.
# Scopes: read:compliance_activities, read:compliance_org_data, read:members,
#         read:rbac_groups, read:analytics, read:spend_limits (nothing else).
# Datasets whose API has no key are reported as "unavailable" (rule OP-002), not as compliant.
ANTHROPIC_ENTERPRISE_API_KEY=

# Optional per-API overrides (use when you split scopes across several keys)
ANTHROPIC_COMPLIANCE_API_KEY=
ANTHROPIC_ANALYTICS_API_KEY=
ANTHROPIC_ADMIN_API_KEY=

# --- Optional: notification channels ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE defaults to true only for port 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
# Comma-separated list
ALERT_EMAIL_TO=

# Link included in alerts and reports
DASHBOARD_URL=

# --- Optional: paths (relative to the directory you run pnpm in) ---
DATA_DIR=data
CONFIG_DIR=config
