# Dependencies
node_modules/

# Build
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
coverage/

# Data — Live audit data MUST NEVER be on main branch (fork-safe)
# Live data lives only on the data/audit orphan branch
data/*.json
data/*.csv
data/snapshots/
data/reports/
data/archive/
data/detail/
data/alerts/
data/usage-matrix/
data/summaries/
# Raw API captures (pnpm collect --capture-raw data/raw/<run>): real tenant data, never committed
data/raw/
# Fixture-tenant output of `pnpm fixture` (synthetic, regenerated; read by DASHBOARD_DATA_SOURCE=fixtures)
data/fixture/
# Generated profiles with the optional sources on (`pnpm fixture --optional-sources`, `pnpm demo --profile optional-sources`)
data/fixture-optional-sources/
data/sample-optional-sources/
# Generated profiles of `pnpm demo --profile empty` and `pnpm demo --profile unavailable`
data/sample-empty/
data/sample-unavailable/
data/state.json
data/dashboard.json
!data/.gitkeep
!data/sample/
!data/sample/**

# Dashboard data staged at build/dev time (from data/sample or data/audit)
packages/dashboard/public/data/

# Logs
logs/
*.log

# change-dev artifacts under .devs/changes/ are shared via PRs; everything else in .devs/ stays local
.devs/*
!.devs/changes/

# Playwright E2E output (build, profiles, report, traces); generated by packages/dashboard/scripts/e2e-prepare.mjs
packages/dashboard/.e2e/
