{
  "name": "@claude-audit/dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage-data.mjs && vite",
    "build": "node scripts/stage-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:e2e": "node scripts/e2e-prepare.mjs && playwright test",
    "test:e2e:report": "playwright show-report .e2e/report"
  },
  "dependencies": {
    "@claude-audit/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
