{
  "name": "@claude-audit/collector",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/main/cli.js",
    "dev": "tsx src/main/cli.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@claude-audit/core": "workspace:*",
    "nodemailer": "^10.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/node": "^26.6.4",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  },
  "description": "Adapters (Anthropic APIs, storage, notifiers, renderers) and the CLI composition root"
}
